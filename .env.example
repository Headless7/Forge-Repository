# ─────────────────────────────────────────────────────────────────────────────
# Forge — environment configuration
# `npm run setup` copies this file to `.env` and fills in random secrets.
# Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in emails, OAuth redirects and CSRF origin checks)
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# With EMBEDDED_POSTGRES=true, `npm run dev` starts a private PostgreSQL server
# (data in .data/postgres) — no Docker or system install needed.
# Point DATABASE_URL at any PostgreSQL 14+ server and set EMBEDDED_POSTGRES=false
# to use your own database instead.
DATABASE_URL=postgres://forge:forge@127.0.0.1:54329/forge
EMBEDDED_POSTGRES=true

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32+ random bytes. Signs private media URLs and OAuth state.
AUTH_SECRET=replace-me-with-a-long-random-string

# ── File storage ────────────────────────────────────────────────────────────
# local  → files stored in STORAGE_LOCAL_DIR, served through signed, expiring URLs
# s3     → any S3-compatible object storage (AWS S3, Cloudflare R2, MinIO …)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Origin that serves presigned URLs (added to the Content-Security-Policy)
# STORAGE_PUBLIC_ORIGIN=https://<bucket>.<account>.r2.cloudflarestorage.com

# Upload limits (megabytes)
MAX_IMAGE_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=2048
MAX_FILE_UPLOAD_MB=500
MAX_AUDIO_UPLOAD_MB=200
MAX_ROBLOX_UPLOAD_MB=150

# ── Roblox previews ─────────────────────────────────────────────────────────
# Models often reference meshes/textures stored on Roblox (rbxassetid://…). Team
# members can always resolve those by uploading the files.
# Previews also try Roblox's no-sign-in download (assetdelivery.roblox.com) when they
# open. Roblox only serves a few, mostly older, assets that way; most need the API key
# below. Set to false to never contact Roblox without a key.
# ROBLOX_PUBLIC_ASSET_FETCH=true
# For private assets, give the server an Open Cloud API key with the
# "legacy-asset:manage" scope; it can fetch assets the key's owner has access to
# (GET apis.roblox.com/asset-delivery-api) and is tried before the public endpoint.
# ROBLOX_OPEN_CLOUD_API_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY or SMTP_URL, emails are recorded in the outbox (visible at
# /dev/outbox in development) and printed to the server console. RESEND_API_KEY sends
# over HTTPS and wins when both are set — use it where outbound SMTP is blocked
# (Railway's Free/Hobby plans block ports 25/465/587).
EMAIL_FROM="Forge <no-reply@forge.local>"
# RESEND_API_KEY=re_...
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Require a verified email before users can use the app
REQUIRE_EMAIL_VERIFICATION=false

# ── Device notifications (Web Push) ─────────────────────────────────────────
# Operating-system notifications on people's browsers/phones, also when Forge isn't open.
# Generate a key pair with `npm run push:keys`. Keep the private key secret (host settings or
# this file only). Browsers require HTTPS (localhost is exempt). Changing the keys later means
# everyone turns device notifications on again. Without keys, device notifications are off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── Private access ──────────────────────────────────────────────────────────
# Forge is invitation-only. The site operators (comma-separated emails) create studios and
# issue activation keys at /admin/keys once their email is confirmed; anyone else needs an
# Owner/Admin invitation to join a studio, or an activation key to create their own.
# PLATFORM_ADMIN_EMAILS=you@example.com
# Total uploaded originals each studio may keep (GB).
# STUDIO_STORAGE_LIMIT_GB=200

# ── OAuth (optional) ────────────────────────────────────────────────────────
# Redirect URI: {APP_URL}/api/auth/oauth/{provider}/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Discord team feeds (optional) ───────────────────────────────────────────
# One Discord application (discord.com/developers) powers both "Sign in with Discord" (the client
# id/secret above) and the Forge bot that posts to team channels. Feeds need all four values.
# Redirect URIs to register in the app's OAuth2 settings:
#   {APP_URL}/api/integrations/discord/callback   (connecting a server)
#   {APP_URL}/api/auth/oauth/discord/callback     (signing in)
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_TOKEN=

# ── Realtime ────────────────────────────────────────────────────────────────
# postgres → LISTEN/NOTIFY fan-out (works across multiple server instances)
# memory   → single-process event bus
REALTIME_DRIVER=postgres

# ── Background jobs ─────────────────────────────────────────────────────────
# Protects /api/cron/* when triggered by an external scheduler (e.g. Vercel Cron).
# Use a random string of 24+ characters (production refuses the placeholder).
CRON_SECRET=replace-me
# Run due-date reminders, email and device-notification delivery and storage cleanup inside the
# Node server process. If false, call GET /api/cron/due-dates (Authorization: Bearer $CRON_SECRET)
# every minute from a scheduler instead.
ENABLE_INPROCESS_JOBS=true

# ── Proxies ─────────────────────────────────────────────────────────────────
# Reverse proxies in front of the app that append X-Forwarded-For (usually 1 behind
# nginx/Caddy/a load balancer). 0 = reached directly: forwarded headers are ignored
# (anyone could send them). Defaults: 1 in development, 0 in production.
# TRUSTED_PROXY_HOPS=1

# ── Development ─────────────────────────────────────────────────────────────
# Shows demo accounts on the sign-in page (ignored in production)
DEMO_MODE=true
# /dev/outbox shows emails when no SMTP_URL is set; it needs a signed-in user or this
# key. `npm run dev` generates one and prints the link, so you rarely need to set it.
# DEV_OUTBOX_KEY=
