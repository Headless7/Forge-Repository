{
  "name": "forge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Production board and media review platform for Roblox game studios.",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "tsx scripts/dev.ts --prod",
    "start:next": "next start",
    "start:prod": "node scripts/migrate-prod.mjs && next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "db:start": "tsx scripts/db-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:flows": "tsx scripts/verify-flows.ts",
    "verify:server": "tsx scripts/verify-server.ts",
    "db:migrate:prod": "node scripts/migrate-prod.mjs",
    "push:keys": "tsx scripts/push-keys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-query": "5.104.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "draco3d": "^1.5.7",
    "drizzle-orm": "0.45.3",
    "ffmpeg-static": "5.3.0",
    "fzstd": "^0.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "nodemailer": "10.0.13",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/draco3d": "^1.4.10",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  },
  "engines": {
    "node": "24.x"
  }
}
